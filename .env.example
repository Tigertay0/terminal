# Nothing is read from .env. Local settings live in two git-ignored places:
#
# .dev.vars (read by the Cloudflare Vite plugin during `npm run dev`):
#   BETTER_AUTH_URL=http://localhost:5173
#   BETTER_AUTH_SECRET=<any long random string>
#   ANTHROPIC_API_KEY=<optional, for AI news>
#
# .secrets/neon-dev-worker.url: the Neon dev branch connection string for the
# terminal_worker role (see README, "Local development").
